#!/bin/sh
# Note to Self launcher for macOS and Linux. Usage: ./notetoself [--dir FOLDER] [--port N] [--no-open]

# Resolve symlinks so this works when linked into ~/bin or /usr/local/bin.
SELF="$0"
while [ -h "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"

if [ -x "$DIR/.venv/bin/python" ]; then
  PY="$DIR/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "Note to Self needs Python 3.8 or newer, but python3 wasn't found." >&2
  echo "Install it from https://www.python.org/downloads/ (or your package manager)." >&2
  exit 1
fi

exec "$PY" "$DIR/notetoself.py" "$@"
